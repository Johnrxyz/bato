# ── Django ─────────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ───────────────────────────────────────────────────────────────────
# Local development (PostgreSQL)
DATABASE_URL=postgres://postgres:password@localhost:5432/taskmanager

# Supabase (production demo) — replace with your Supabase connection string
# DATABASE_URL=postgres://postgres:[password]@db.[ref].supabase.co:5432/postgres

# PythonAnywhere MySQL fallback (if PostgreSQL unavailable)
# DATABASE_URL=mysql://username:password@username.mysql.pythonanywhere-services.com/username$dbname

# ── CORS ───────────────────────────────────────────────────────────────────────
# Local dev
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production (Vercel URL — add after deployment)
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Redis / Channels (Docker production only) ──────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── File Storage ───────────────────────────────────────────────────────────────
# Local dev — files stored in /media
USE_S3=False

# AWS S3 (optional for production)
# USE_S3=True
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=ap-southeast-1

# ── Email ──────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# ── PythonAnywhere ─────────────────────────────────────────────────────────────
# Set DJANGO_SETTINGS_MODULE=config.settings.production in PA WSGI config
# FRONTEND_URL=https://your-app.vercel.app
